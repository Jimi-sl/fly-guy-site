# Cloudflare Pages response headers (GitHub Pages ignores this file).

# Game build files are named by content hash, so they never change: cache them for good.
/play/Build/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

# Comic panels can be re-exported under the same name, so cache them for a day.
/files/issues/*
  Cache-Control: public, max-age=86400

# Uncompressed test build: Cloudflare Brotli-compresses on the fly, but only for content
# types on its list, which doesn't include the .data file's default type.
/play-test/Build/*
  Cache-Control: public, max-age=31536000, immutable

/play-test/Build/*.data
  Content-Type: application/wasm
